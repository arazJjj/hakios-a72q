/* HakiOS's U-Boot on the Galaxy A72 (a72q): board/qualcomm/qcom-phone.env with HakiOS's boot first */
bootdelay=0
bootretry=1
stdin=serial,button-kbd
stdout=serial,vidconsole
stderr=serial,vidconsole

fastboot=fastboot -l $fastboot_addr_r usb 0

/* UFS: the HakiOS loader reads its partitions (logdump, darwin) through U-Boot's block devices */
preboot=scsi scan

/*
 * The HakiOS loader and its payload from memory: from the boot image's ramdisk when ABL brought one, else from the
 * host over fastboot (hakios_fastboot). Nothing is written to the phone's storage on the way.
 */
/* every start: the HakiOS screen, two buttons; volume keys move, power selects, BOOT iOS (red) is the default */
bootcmd=while true; do hakmenu "HakiOS" "0.1  -  GALAXY A72" "BOOT iOS 16.5" "run boot_ios" "REBOOT" "reset"; done
boot_ios=if hakios load; then hakios boot; fi; pause
hakios_fastboot=echo; echo "HakiOS: waiting for the host:"; \
	echo "  fastboot stage x.hkub"; \
	echo "  fastboot oem run:hakios load fastboot"; \
	echo "  fastboot continue"; \
	setenv bootretry -1; run fastboot; hakios boot; pause; run menucmd

serial_gadget=setenv stdin serial,button-kbd,usbacm; \
	setenv stdout serial,vidconsole,usbacm; \
	setenv stderr serial,vidconsole,usbacm; \
	setenv bootretry -1; \
	echo Enabled U-Boot console serial gadget

menucmd=setenv bootcmd run menucmd; run advmenu_set; bootmenu -1

advmenu_set=setenv bootmenu_0 "HakiOS (from memory)=hakios load; hakios boot; pause"; setenv bootmenu_1 "HakiOS over fastboot=run hakios_fastboot"; setenv bootmenu_2 "Enable serial console gadget=run serial_gadget"; setenv bootmenu_3 "Enable fastboot mode=run fastboot"; setenv bootmenu_4 "What is in memory=hakios info; pause"; setenv bootmenu_5 "Drop to shell=setenv bootretry -1"; setenv bootmenu_6 "Reset device=reset"; setenv bootmenu_7 "Board info=bdinfo; meminfo; pause"

/* hold volume down while U-Boot starts: the full developer menu */
button_cmd_0_name=Volume Down
button_cmd_0=run menucmd
