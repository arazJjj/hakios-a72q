+/* a72q: read SIZE bytes from the start of the partition named darwin into DEST (the resident image). */
+static int
+resflash_load(void *dest, uint64_t size)
+{
+	static const efi_guid part_guid = EFI_PARTITION_INFO_GUID;
+	static const efi_guid blk_guid = EFI_BLOCK_IO_GUID;
+	efi_handle *handles;
+	uint64_t count;
+	int done = 0;
+
+	if (EFI_ERROR(BS->locate_handle_buffer(ByProtocol, &part_guid, NULL, &count, &handles))) {
+		print("resflash: no partitions\n");
+		return 0;
+	}
+	for (uint64_t i = 0; i < count && !done; i++) {
+		efi_partition_info *info;
+		efi_block_io *bio;
+		char name[36];
+
+		if (EFI_ERROR(BS->handle_protocol(handles[i], &part_guid, (void **)&info)) || info->type != 2 ||
+		    EFI_ERROR(BS->handle_protocol(handles[i], &blk_guid, (void **)&bio)) || bio->media->block_size == 0) {
+			continue;
+		}
+		ufs_name(info, name, sizeof(name));
+		if (!(name[0] == 'd' && name[1] == 'a' && name[2] == 'r' && name[3] == 'w' && name[4] == 'i' &&
+		    name[5] == 'n' && name[6] == 0)) {
+			continue;
+		}
+		uint64_t bs = bio->media->block_size, total = (size + bs - 1) / bs * bs, off = 0;
+		if (total / bs > bio->media->last_block + 1) {
+			print("resflash: %x bytes do not fit in darwin\n", size);
+			break;
+		}
+		print("resflash: reading %x bytes of darwin (blocks of %d)\n", total, bs);
+		while (off < total) {
+			uint64_t n = total - off > 0x4000000ULL ? 0x4000000ULL : total - off;
+			efi_status s = bio->read_blocks(bio, bio->media->media_id, off / bs, n, (uint8_t *)dest + off);
+			if (EFI_ERROR(s)) {
+				print("resflash: read at %x failed\n", off);
+				break;
+			}
+			off += n;
+		}
+		done = off >= total;
+	}
+	BS->free_pool(handles);
+	if (!done) {
+		print("resflash: no usable partition darwin\n");
+	}
+	return done;
+}
