diff --git a/drivers/pinctrl/qcom/pinctrl-sc7180.c b/drivers/pinctrl/qcom/pinctrl-sc7180.c
new file mode 100644
index 00000000..f5012fde
--- /dev/null
+++ b/drivers/pinctrl/qcom/pinctrl-sc7180.c
@@ -0,0 +1,123 @@
+// SPDX-License-Identifier: BSD-3-Clause
+/*
+ * Pinctrl driver for Qualcomm SC7180 / SM7125 (HakiOS, Galaxy A72 port).
+ * Tiles and special pins from Linux drivers/pinctrl/qcom/pinctrl-sc7180.c; U-Boot maps the first
+ * reg (west, 0x3500000) and the north/south tiles follow it at +0x400000 / +0x800000.
+ */
+
+#include <dm.h>
+
+#include "pinctrl-qcom.h"
+
+#define WEST	0x00000000
+#define NORTH	0x00400000
+#define SOUTH	0x00800000
+
+#define MAX_PIN_NAME_LEN 32
+static char pin_name[MAX_PIN_NAME_LEN] __section(".data");
+
+static const struct pinctrl_function msm_pinctrl_functions[] = {
+	{ "gpio", 0 },
+};
+
+#define SDC_QDSD_PINGROUP(pg_name, ctl, pull, drv)	\
+	{						\
+		.name = pg_name,			\
+		.ctl_reg = SOUTH + ctl,			\
+		.io_reg = 0,				\
+		.pull_bit = pull,			\
+		.drv_bit = drv,				\
+		.oe_bit = -1,				\
+		.in_bit = -1,				\
+		.out_bit = -1,				\
+	}
+
+#define UFS_RESET(pg_name, offset)			\
+	{						\
+		.name = pg_name,			\
+		.ctl_reg = SOUTH + offset,		\
+		.io_reg = SOUTH + offset + 0x4,		\
+		.pull_bit = 3,				\
+		.drv_bit = 0,				\
+		.oe_bit = -1,				\
+		.in_bit = -1,				\
+		.out_bit = 0,				\
+	}
+
+static const struct msm_special_pin_data msm_special_pins_data[] = {
+	[0] = UFS_RESET("ufs_reset", 0x7f000),
+	[1] = SDC_QDSD_PINGROUP("sdc1_rclk", 0x7a000, 15, 0),
+	[2] = SDC_QDSD_PINGROUP("sdc1_clk", 0x7a000, 13, 6),
+	[3] = SDC_QDSD_PINGROUP("sdc1_cmd", 0x7a000, 11, 3),
+	[4] = SDC_QDSD_PINGROUP("sdc1_data", 0x7a000, 9, 0),
+	[5] = SDC_QDSD_PINGROUP("sdc2_clk", 0x7b000, 14, 6),
+	[6] = SDC_QDSD_PINGROUP("sdc2_cmd", 0x7b000, 11, 3),
+	[7] = SDC_QDSD_PINGROUP("sdc2_data", 0x7b000, 9, 0),
+};
+
+static const unsigned int sc7180_pin_offsets[] = {
+	[0] = SOUTH, [1] = SOUTH, [2] = SOUTH, [3] = SOUTH, [4] = NORTH, [5] = NORTH, [6] = NORTH, [7] = NORTH,
+	[8] = NORTH, [9] = NORTH, [10] = NORTH, [11] = NORTH, [12] = SOUTH, [13] = SOUTH, [14] = SOUTH, [15] = SOUTH,
+	[16] = SOUTH, [17] = SOUTH, [18] = SOUTH, [19] = SOUTH, [20] = SOUTH, [21] = NORTH, [22] = NORTH, [23] = SOUTH,
+	[24] = SOUTH, [25] = SOUTH, [26] = SOUTH, [27] = SOUTH, [28] = SOUTH, [29] = NORTH, [30] = SOUTH, [31] = NORTH,
+	[32] = NORTH, [33] = NORTH, [34] = SOUTH, [35] = SOUTH, [36] = SOUTH, [37] = SOUTH, [38] = SOUTH, [39] = SOUTH,
+	[40] = SOUTH, [41] = SOUTH, [42] = NORTH, [43] = NORTH, [44] = NORTH, [45] = NORTH, [46] = NORTH, [47] = NORTH,
+	[48] = NORTH, [49] = WEST, [50] = WEST, [51] = WEST, [52] = WEST, [53] = WEST, [54] = WEST, [55] = WEST,
+	[56] = WEST, [57] = WEST, [58] = WEST, [59] = NORTH, [60] = NORTH, [61] = NORTH, [62] = NORTH, [63] = NORTH,
+	[64] = NORTH, [65] = NORTH, [66] = NORTH, [67] = NORTH, [68] = NORTH, [69] = WEST, [70] = NORTH, [71] = NORTH,
+	[72] = NORTH, [73] = WEST, [74] = WEST, [75] = WEST, [76] = WEST, [77] = WEST, [78] = WEST, [79] = WEST,
+	[80] = WEST, [81] = WEST, [82] = WEST, [83] = WEST, [84] = WEST, [85] = WEST, [86] = NORTH, [87] = NORTH,
+	[88] = NORTH, [89] = NORTH, [90] = NORTH, [91] = NORTH, [92] = NORTH, [93] = NORTH, [94] = SOUTH, [95] = WEST,
+	[96] = WEST, [97] = WEST, [98] = WEST, [99] = WEST, [100] = WEST, [101] = NORTH, [102] = NORTH, [103] = NORTH,
+	[104] = WEST, [105] = NORTH, [106] = NORTH, [107] = WEST, [108] = SOUTH, [109] = SOUTH, [110] = NORTH, [111] = NORTH,
+	[112] = NORTH, [113] = NORTH, [114] = NORTH, [115] = WEST, [116] = WEST, [117] = WEST, [118] = WEST,
+	[119] = SOUTH, [120] = SOUTH, [121] = SOUTH, [122] = SOUTH,
+	[123] = SOUTH, [124] = SOUTH, [125] = SOUTH, [126] = SOUTH,
+};
+
+static const char *sc7180_get_function_name(struct udevice *dev, unsigned int selector)
+{
+	return msm_pinctrl_functions[selector].name;
+}
+
+static const char *sc7180_get_pin_name(struct udevice *dev, unsigned int selector)
+{
+	if (selector >= 119 && selector <= 126)
+		snprintf(pin_name, MAX_PIN_NAME_LEN, "%s",
+			 msm_special_pins_data[selector - 119].name);
+	else
+		snprintf(pin_name, MAX_PIN_NAME_LEN, "gpio%u", selector);
+
+	return pin_name;
+}
+
+static int sc7180_get_function_mux(__maybe_unused unsigned int pin, unsigned int selector)
+{
+	return msm_pinctrl_functions[selector].val;
+}
+
+static struct msm_pinctrl_data sc7180_data = {
+	.pin_data = {
+		.pin_offsets = sc7180_pin_offsets,
+		.pin_count = 127,
+		.special_pins_start = 119,
+		.special_pins_data = msm_special_pins_data,
+	},
+	.functions_count = ARRAY_SIZE(msm_pinctrl_functions),
+	.get_function_name = sc7180_get_function_name,
+	.get_function_mux = sc7180_get_function_mux,
+	.get_pin_name = sc7180_get_pin_name,
+};
+
+static const struct udevice_id msm_pinctrl_ids[] = {
+	{ .compatible = "qcom,sc7180-pinctrl", .data = (ulong)&sc7180_data },
+	{ /* sentinel */ }
+};
+
+U_BOOT_DRIVER(pinctrl_sc7180) = {
+	.name		= "pinctrl_sc7180",
+	.id		= UCLASS_NOP,
+	.of_match	= msm_pinctrl_ids,
+	.ops		= &msm_pinctrl_ops,
+	.bind		= msm_pinctrl_bind,
+};
diff --git a/drivers/usb/dwc3/gadget.c b/drivers/usb/dwc3/gadget.c
index 24ae0c23..1cd4eed2 100644
--- a/drivers/usb/dwc3/gadget.c
+++ b/drivers/usb/dwc3/gadget.c
@@ -1097,6 +1097,28 @@ static int __dwc3_gadget_ep_queue(struct dwc3_ep *dep, struct dwc3_request *req)
 			dev_dbg(dwc->dev, "%s: failed to kick transfers\n",
 					dep->name);
 		}
+		return 0;
+	}
+
+	/*
+	 * 5. Bulk and interrupt endpoints start at once, as Linux's dwc3
+	 * does now, instead of on the XferNotReady that the host's next
+	 * token brings: a request queued after that event had been taken
+	 * (or with BUSY left over from the transfer before) waited for one
+	 * that never came, and a receive of a megabyte took nothing for as
+	 * long as it was let wait (seen on the POCO X5 Pro, xl's downloads).
+	 */
+	if (!usb_endpoint_xfer_isoc(dep->endpoint.desc)) {
+		if ((dep->flags & DWC3_EP_BUSY) && list_empty(&dep->req_queued)) {
+			/* nothing of the gadget's is with the hardware */
+			dwc3_stop_active_transfer(dwc, dep->number, true);
+			dep->flags &= ~DWC3_EP_BUSY;
+		}
+		ret = __dwc3_gadget_kick_transfer(dep, 0, true);
+		if (ret && ret != -EBUSY)
+			dev_dbg(dwc->dev, "%s: failed to kick transfers\n",
+					dep->name);
+		return ret == -EBUSY ? 0 : ret;
 	}
 
 	return 0;
@@ -1214,6 +1236,34 @@ int __dwc3_gadget_ep_set_halt(struct dwc3_ep *dep, int value, int protocol)
 		else
 			dep->flags |= DWC3_EP_STALL;
 	} else {
+		bool restart = false;
+
+		/*
+		 * A transfer the hardware has started ends before the stall
+		 * is cleared, and starts again after, as Linux does: a
+		 * ClearStall under a started transfer resets the sequence
+		 * number of a TRB in use, and the endpoint took no more data.
+		 * WinUSB clears the halt of a pipe it opens, at any time,
+		 * often with the gadget's next receive already queued.
+		 */
+		if (dep->flags & DWC3_EP_BUSY) {
+			struct dwc3_request *req;
+
+			dwc3_stop_active_transfer(dwc, dep->number, true);
+			/* back in front of the requests not yet started, in their order */
+			while (!list_empty(&dep->req_queued)) {
+				req = list_last_entry(&dep->req_queued,
+						      struct dwc3_request, list);
+				req->queued = false;
+				req->trb = NULL;
+				req->request.actual = 0;
+				list_move(&req->list, &dep->request_list);
+			}
+			dep->busy_slot = 0;
+			dep->free_slot = 0;
+			restart = true;
+		}
+
 		ret = dwc3_send_gadget_ep_cmd(dwc, dep->number,
 			DWC3_DEPCMD_CLEARSTALL, &params);
 		if (ret)
@@ -1221,6 +1271,9 @@ int __dwc3_gadget_ep_set_halt(struct dwc3_ep *dep, int value, int protocol)
 					dep->name);
 		else
